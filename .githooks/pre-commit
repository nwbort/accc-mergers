#!/bin/sh
# Bump the sitemap lastmod of a hand-edited static page (commentary, author,
# privacy, copyright) when a commit touches its source.
# See scripts/generate/sitemap_lastmod.py. Enable with:
#   git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
exec python3 -m scripts.generate.sitemap_lastmod --staged
